<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- الشريط العلوي: العنوان + تشغيل + إيقاف -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title"
            android:textColor="@color/bar_fg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRun"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/run"
            android:textColor="#34D399" />

        <Button
            android:id="@+id/btnStop"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop"
            android:textColor="#F87171" />
    </LinearLayout>

    <!-- أدوات الملف والمحرر -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar_bg"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnOpen"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open"
                android:textColor="@color/bar_fg" />

            <Button
                android:id="@+id/btnSave"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:textColor="@color/bar_fg" />

            <Button
                android:id="@+id/btnExample"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/example"
                android:textColor="@color/bar_fg" />

            <Button
                android:id="@+id/btnFormat"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/format"
                android:textColor="@color/bar_fg" />

            <Button
                android:id="@+id/btnTheme"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme"
                android:textColor="@color/bar_fg" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- شريط الرموز: أزرار لإدراج الرموز والكلمات الصعبة على لوحة المفاتيح العربية -->
    <HorizontalScrollView
        android:id="@+id/symbolScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/symbol_bg"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/symbolBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:padding="2dp" />
    </HorizontalScrollView>

    <!-- المحرر -->
    <EditText
        android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/editor_bg"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:lineSpacingMultiplier="1.35"
        android:padding="16dp"
        android:textColor="@color/editor_fg"
        android:textDirection="anyRtl"
        android:textSize="16sp"
        android:typeface="monospace" />

    <!-- المدخلات -->
    <EditText
        android:id="@+id/stdin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/symbol_bg"
        android:gravity="top|start"
        android:hint="@string/stdin_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="3"
        android:padding="10dp"
        android:textDirection="anyRtl"
        android:textSize="14sp" />

    <!-- المخرجات -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/output_bg">

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/output_hint"
            android:lineSpacingMultiplier="1.3"
            android:padding="16dp"
            android:textColor="@color/output_fg"
            android:textDirection="anyRtl"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:typeface="monospace" />
    </ScrollView>

</LinearLayout>
