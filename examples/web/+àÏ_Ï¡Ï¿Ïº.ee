برنامج مرحبا_ويب

// برنامج EE# عادي: يُترجَم إلى صفحة ويب (ee translate --target web) أو تطبيق أندرويد (--target android).
// المخرجات تظهر في صفحة الويب، وتتفاعل الصفحة عبر الصدفة.

$اعرض "المنصة:", <<منصة>>, "— الإصدار:", <<اصدار>>

لو $على_منصة("ويب") او $على_منصة("اندرويد")
  $صدفة_html("#app", "<button id='ازرار'>اضغط</button> <b id='نتيجة'>—</b>")
  متغير <<ن>> = 0
  $صدفة_اربط("#ازرار", "click", مفهوم()
    <<ن>> += 1
    $صدفة_نص("#نتيجة", $ارقام_عربية(<<ن>>))
    $صدفة_رسالة("ضغطة رقم " + <<ن>>)
  نهاية)
والا
  $اعرض "لا توجد صفحة هنا؛ شغّل الهدف web أو android"
نهاية لو

نهاية برنامج
