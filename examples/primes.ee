برنامج الاعداد_الاولية

مفهوم $اولي(<<ن>>)
  لو <<ن>> اصغر من 2
    ارجع خطأ
  نهاية لو
  متغير <<د>> = 2
  كرر <<د>> * <<د>> اصغر من او يساوي <<ن>>
    لو <<ن>> % <<د>> = 0
      ارجع خطأ
    نهاية لو
    <<د>> += 1
  نهاية كرر
  ارجع صح
نهاية مفهوم

متغير <<النتيجة>> = []
لكل <<ع>> في $مدى(1, 51)
  لو $اولي(<<ع>>)
    $اضف(<<النتيجة>>, <<ع>>)
  نهاية لو
نهاية لكل

$اعرض "الأعداد الأولية:", <<النتيجة>>
$اعرض "عددها:", $طول(<<النتيجة>>)

نهاية برنامج
