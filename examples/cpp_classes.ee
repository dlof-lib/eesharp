صنف $شكل
  مفهوم $مساحة()
    ارجع 0
  نهاية مفهوم
  مفهوم $وصف()
    ارجع "المساحة = " + $نص(<<هذا>>.$مساحة())
  نهاية مفهوم
نهاية صنف
صنف $مستطيل يرث $شكل
  مفهوم $انشاء(<<ط>>, <<ع>>)
    <<هذا>>.<<ط>> = <<ط>>؛ <<هذا>>.<<ع>> = <<ع>>
  نهاية مفهوم
  مفهوم $مساحة()
    ارجع <<هذا>>.<<ط>> × <<هذا>>.<<ع>>
  نهاية مفهوم
نهاية صنف
لكل <<ش>> في [$مستطيل(3, 4), $شكل()]؛ $اعرض <<ش>>.$وصف()؛ نهاية لكل
