برنامج مرحبا

// برنامجي الأول في EE#
// المفهوم يبدأ بـ $    والمتغير بين << >>    والقيمة نص بين " " أو رقم
// اسم المتغير من عدة كلمات يُوصل بـ _   مثل  <<اسم_المستخدم>>

متغير <<اسم_المستخدم>> = "أحمد"
$اعرض "مرحباً بالعالم!"
$اعرض "اسمي:", <<اسم_المستخدم>>

لو <<اسم_المستخدم>> = "أحمد"
  $اعرض "أهلاً يا أحمد"
نهاية لو

نهاية برنامج
