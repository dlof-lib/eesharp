برنامج صفحة_نتائج

متغير <<مواد>> = ["الرياضيات", "العلوم", "اللغة", "التاريخ"]
متغير <<درجات>> = [92, 85, 78, 88]
متغير <<صفوف>> = $ضم(<<مواد>>, <<درجات>>)
متغير <<معدل>> = $مجموع(<<درجات>>) / $طول(<<درجات>>)

متغير <<ملخص>> = $بطاقة("المعدل العام", "حصلتُ على ", $ابراز(<<معدل>>), " من 100")
متغير <<تفاصيل>> = $بطاقة("الدرجات", $جدول(["المادة", "الدرجة"], <<صفوف>>))
متغير <<رسم>> = $بطاقة("رسم بياني", $رسم_اعمدة(<<مواد>>, <<درجات>>))

$اعرض $صفحة("نتائج الفصل",
  $تنقل([["الملخص", "#ملخص"], ["الدرجات", "#تفاصيل"]]),
  $بطل("نتائج الفصل الأول", "صفحة كاملة مكتوبة بلغة EE# بلا سطر HTML واحد"),
  $رئيسي($معرف("ملخص", <<ملخص>>), $معرف("تفاصيل", <<تفاصيل>>), <<رسم>>),
  $تذييل("صُنعت بلغة EE#"))

نهاية برنامج
