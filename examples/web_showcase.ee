برنامج واجهة_احترافية

متغير <<مميزات>> = [
  $بطاقة_ميزة("⚡", "سريع", "تشغيل فوري بلا إعداد"),
  $بطاقة_ميزة("🔒", "آمن", "كل نص يُهرَّب تلقائياً"),
  $بطاقة_ميزة("🎨", "جميل", "وضع داكن وتجاوب كامل")
]
متغير <<اسعار>> = [
  $بطاقة_سعر("أساسية", "٠ ريال", ["مشروع واحد", "دعم المجتمع"], "ابدأ مجاناً", خطأ),
  $بطاقة_سعر("احترافية", "٤٩ ريال", ["مشاريع بلا حد", "دعم سريع", "نطاق خاص"], "اشترك الآن", صح)
]
متغير <<احصاءات>> = [
  $بطاقة_احصائية("١٢٠٠", "مستخدم", "👥"),
  $بطاقة_احصائية("٩٩٪", "رضا العملاء", "⭐")
]

$اعرض $صفحة("واجهة احترافية",
  $شريط_علوي($شعار("EE#", "◆"), [["الميزات", "#m"], ["الأسعار", "#p"], ["الأسئلة", "#q"]]),
  $بطل_بسيط("ابنِ صفحتك بالعربية", "مئة مكوّن جاهز بسطر واحد لكل منها", "ابدأ الآن", "#p"),
  $معرف("m", $قسم_ميزات("لماذا EE#؟", <<مميزات>>, "كل ما تحتاجه")),
  $قسم_احصائيات(<<احصاءات>>),
  $معرف("p", $قسم_اسعار("الباقات", <<اسعار>>)),
  $رئيسي(
    $رسم_دائري(["أ", "ب", "ج"], [50, 30, 20]),
    $رسم_خطي(["يناير", "فبراير", "مارس"], [10, 25, 18]),
    $شريط_تقدم(70, "الإنجاز"),
    $تقييم_نجوم(4.5, 5),
    $تبويبات([["الأول", "محتوى أول"], ["الثاني", "محتوى ثانٍ"]]),
    $ترقيم_صفحات(3, 8, "?p={}"),
    $نموذج_اتصال()),
  $معرف("q", $قسم_اسئلة("أسئلة شائعة", [["هل هو مجاني؟", "نعم"], ["هل يعمل بلا إنترنت؟", "نعم"]])),
  $قسم_دعوة("جاهز؟", "ابدأ الآن مجاناً", "انطلق", "#"),
  $تذييل_كامل("EE#", "لغة عربية للبرمجة", [["روابط", [["الرئيسية", "#"]]]], "© ٢٠٢٦"))

نهاية برنامج
