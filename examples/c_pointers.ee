مفهوم $بدل(<<أ>>, <<ب>>)
  متغير <<ت>> = *<<أ>>؛ *<<أ>> = *<<ب>>؛ *<<ب>> = <<ت>>
نهاية مفهوم
متغير <<س>> = 1؛ متغير <<ص>> = 2؛ $بدل(&<<س>>, &<<ص>>)؛ $اعرض <<س>>, <<ص>>
متغير <<م>> = $احجز(5)
لكل <<ع>> في $مدى(5)؛ *(<<م>> + <<ع>>) = <<ع>> × <<ع>>؛ نهاية لكل
متغير <<ج>> = 0؛ متغير <<ن>> = <<م>>
كرر <<ن>> - <<م>> < 5؛ <<ج>> += *<<ن>>؛ <<ن>> = <<ن>> + 1؛ نهاية كرر
$اعرض "المجموع:", <<ج>>؛ $حرر(<<م>>)
