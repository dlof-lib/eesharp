برنامج مكونات_جديدة

$اعرض $صفحة("مكونات جديدة",
  $شريط_علوي($شعار("EE#", "◆"), [["الرئيسية", "#"]]),
  $خلفية_متدرجة("بنفسجي",
    $عنوان_مزخرف("واجهات عصرية بسطر واحد", 1),
    $صندوق_زجاجي($نص_كبير("زجاج شفاف فوق خلفية متدرجة"), $وسوم(["سريع", "آمن", "عربي"]))),
  $رئيسي(
    $شريط_متحرك(["شركة أ", "شركة ب", "شركة ج", "شركة د"]),
    $شبكة_متجاوبة(220,
      $بطاقة_متدرجة("الأداء", "تحميل فوري", "برتقالي"),
      $بطاقة_متدرجة("الأمان", "تهريب تلقائي", "اخضر"),
      $بطاقة_متدرجة("الجمال", "وضع داكن", "ازرق")),
    $فاصل_بعنوان("المعاينة"),
    $نافذة_متصفح("ee-sharp.dev", $تقدم_دائري(72, "إنجاز"), $اعمدة_افقية(["أ", "ب", "ج"], [30, 80, 55])),
    $عنوان_مزخرف("الكود", 2),
    $كتلة_كود("$اعرض \"مرحباً\"", "EE#"),
    $طرفية(["ee برنامج.ee", "ee --version"]),
    $جدول_مقارنة(["أساسية", "احترافية"], [["مشاريع", ["1", "∞"]], ["دعم", [خطأ, صح]]]),
    $سجل_تغييرات([["0.2", "٢٠٢٦", ["أخطاء", "وحدات"]]]),
    $بطاقة_حدث("١٥", "نوفمبر", "ملتقى المطورين", "بيروت"),
    $تعليق("a.png", "سارة", "ممتاز!", "قبل ساعة"),
    $بطاقة_اتصال("+9611234567", "a@b.com", "بيروت"),
    $ساعات_عمل([["الأحد", "٩–٥"], ["الاثنين", "٩–٥"]]),
    $قائمة_منسدلة("المزيد", [["حول", "#"], ["اتصل", "#"]]),
    $مجموعة_مشاركة($رابط_مشاركة("واتساب", "https://x.com", "شاهد"), $رابط_مشاركة("تويتر", "https://x.com", "شاهد")),
    $ظهور($اقتباس_جانبي("اقتباس جانبي")),
    $وقت_القراءة("كلمة " * 400),
    $شريط_كوكيز("نستخدم ملفات تعريف الارتباط", "فهمت")),
  $زر_واتساب("+9611234567", "تواصل"))

نهاية برنامج
