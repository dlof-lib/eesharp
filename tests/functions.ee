// المفاهيم: تعريف واستدعاء وتعاود وإغلاقات
مفهوم $مضروب(<<ن>>)
  لو <<ن>> <= 1
    ارجع 1
  نهاية
  ارجع <<ن>> * $مضروب(<<ن>> - 1)
نهاية
$اعرض $مضروب(10)

مفهوم $فيبو <<ن>>
  لو <<ن>> < 2
    ارجع <<ن>>
  نهاية
  ارجع $فيبو(<<ن>> - 1) + $فيبو(<<ن>> - 2)
نهاية
$اعرض $فيبو(15)

مفهوم $عداد()
  متغير <<ع>> = 0
  ارجع مفهوم()
    <<ع>> += 1
    ارجع <<ع>>
  نهاية
نهاية
متغير <<ز>> = $عداد()
<<ز>>()
<<ز>>()
$اعرض <<ز>>()

متغير <<مربع>> = مفهوم(<<س>>) ارجع <<س>> * <<س>> نهاية
$اعرض <<مربع>>(9)

// مفهوم كقيمة: نمرره بلا أقواس
مفهوم $ضعف <<س>>
  ارجع <<س>> * 2
نهاية
متغير <<ف>> = $ضعف
$اعرض <<ف>>(21)

مفهوم $عمق(<<ن>>)
  لو <<ن>> == 0
    ارجع 0
  نهاية
  ارجع 1 + $عمق(<<ن>> - 1)
نهاية
$اعرض $عمق(900)

متغير <<مجموع>> = 0
لكل <<ع>> في [1, 2, 3, 4]
  لو <<ع>> % 2 == 0
    <<مجموع>> += <<ع>>
  نهاية
نهاية
$اعرض "مجموع الأعداد الزوجية:", <<مجموع>>
