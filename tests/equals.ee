// = في بداية الجملة إسناد، وداخل التعابير مساواة
متغير <<س>> = 5
لو <<س>> = 5
  $اعرض "يساوي خمسة"
نهاية لو
$اعرض <<س>> = 5, <<س>> = 6, ليس <<س>> = 3, <<س>> لا يساوي 5
كرر <<س>> = 5
  <<س>> += 1
نهاية كرر
$اعرض <<س>>
متغير <<ق>> = [1, 2]
<<ق>>[0] = 9
$اعرض <<ق>>, $طول(<<ق>>) = 2, <<ق>>[0] = 9
لو (<<س>> = 6) و <<ق>>[1] = 2
  $اعرض "شرطان"
نهاية لو
<<س>> = <<س>> = 6
$اعرض <<س>>
// يساوي ما زالت تعمل كمرادف
$اعرض 1 يساوي 1
$اعرض 5 لا = 6, 5 لا = 5
