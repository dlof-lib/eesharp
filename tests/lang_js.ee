متغير <<ق>> = [1, 2, 3, 4, 5, 6]
$اعرض $خريطة(<<ق>>, <<س>> => <<س>> × <<س>>)
$اعرض $رشح(<<ق>>, (<<س>>) => <<س>> ٪ 2 = 0)
$اعرض $اختزل(<<ق>>, (<<أ>>, <<ب>>) => <<أ>> + <<ب>>, 0)
$اعرض $رتب_حسب(["ccc", "a", "bb"], (<<أ>>, <<ب>>) => $طول(<<أ>>) - $طول(<<ب>>))
متغير <<ضعف>> = <<س>> => <<س>> × 2
متغير <<زد>> = <<س>> => <<س>> + 1
$اعرض $ركب(<<ضعف>>, <<زد>>)(5)
متغير <<ضرب>> = (<<أ>>, <<ب>>) => <<أ>> × <<ب>>
متغير <<في_ثلاثة>> = $جزئي(<<ضرب>>, 3)
$اعرض <<في_ثلاثة>>(7), $ابحث([1, 8, 12], <<س>> => <<س>> > 5), $اي([1, 2], <<س>> => <<س>> > 1), $كل([1, 2], <<س>> => <<س>> > 1)
$اعرض $خريطة(["أ", "ب"], (<<ح>>, <<ف>>) => <<ف>>)
