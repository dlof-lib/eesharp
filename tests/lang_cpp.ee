صنف $حيوان
  متغير <<ارجل>> = 4
  مفهوم $انشاء(<<اسم>>)
    <<هذا>>.<<اسم>> = <<اسم>>
  نهاية مفهوم
  مفهوم $تكلم()
    $اعرض <<هذا>>.<<اسم>>, "يصدر صوتاً"
  نهاية مفهوم
نهاية صنف
صنف $كلب يرث $حيوان
  مفهوم $انشاء(<<اسم>>, <<نوع>>)
    $الاب(<<اسم>>)
    <<هذا>>.<<نوع>> = <<نوع>>
  نهاية مفهوم
  مفهوم $تكلم()
    $الاب()
    $اعرض <<هذا>>.<<اسم>>, "ينبح!", <<هذا>>.<<ارجل>>
  نهاية مفهوم
نهاية صنف
متغير <<ك>>: $حيوان = $كلب("ريكس", "لابرادور")
<<ك>>.$تكلم()
<<ك>>.<<ارجل>> += 1
$اعرض <<ك>>, $نوع(<<ك>>), <<ك>>.<<ارجل>>
متغير <<ف>> = <<ك>>.$تكلم
<<ف>>()
$اعرض <<ك>> = <<ك>>, <<ك>> = $كلب("س", "ص")
$اعرض <<ك>>.<<مجهول>>
