$اعرض $فقرة("<script>alert(1)</script> & \"س\"")
$اعرض $رابط("اضغط", "javascript:alert(1)"), $رابط("آمن", "https://a.b/?x=1&y=2")
$اعرض $نمط("color:red", $صنف_css("مهم", $فقرة("أ", $ابراز("ب"))))
$اعرض $صنف_css("ثانٍ", $بطاقة("ع", "ن"))
$اعرض $قائمة_نقطية(["أ", $ابراز("ب"), 3])
$اعرض $جدول(["س"], [["1<"], [2]])
$اعرض $وسم_html("div", [["data-x", "a\"b"], ["hidden", صح]], "نص", $فقرة("ج"))
$اعرض $عنوان("مرحبا", 2), $صورة("a.png", "وصف"), $زر("اضغط", "alert(1)")
$اعرض $فقرة("أ") + $فقرة("ب"), $فقرة("أ") + "<b>"
متغير <<ص>> = $صفحة("عنوان <1>", $فقرة("ب"))
$اعرض $يحتوي(<<ص>>, "<title>عنوان &lt;1&gt;</title>"), $يحتوي(<<ص>>, "dir=\"rtl\""), $يحتوي(<<ص>>, "<p>ب</p>")
$اعرض $رسم_اعمدة(["أ", "ب"], [1, 2])
$عنوان("س", 9)
