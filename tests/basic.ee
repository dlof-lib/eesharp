// الأساسيات: المفهوم $  ·  المتغير <<>>  ·  القيمة "نص" أو رقم
$اعرض "مرحباً بالعالم!"
متغير <<س>> = ١٠
متغير <<ص>> = 3.5
$اعرض <<س>> + <<ص>>, <<س>> * ٢, <<س>> / 4, <<س>> % 3
$اعرض "نص" + " " + "مدمج", ١ + "أ"
متغير <<ق>> = [1، 2، 3]
$اضف(<<ق>>, 4)
<<ق>>[0] = 100
<<ق>>[1] += 5
$اعرض <<ق>>, $طول(<<ق>>), <<ق>>[-1]
متغير <<ن>> = 0
كرر <<ن>> < 5
  <<ن>> += 1
  لو <<ن>> == 2
    استمر
  نهاية
  لو <<ن>> == 4
    توقف
  نهاية
  $اعرض "ن =", <<ن>>
نهاية
لو <<ن>> > 10
  $اعرض "كبير"
والا لو <<ن>> == 4
  $اعرض "أربعة"
والا
  $اعرض "آخر"
نهاية
لكل <<ح>> في "أبج"
  $اكتب <<ح>>, "-"
نهاية
$اعرض
لكل <<ك>> في $مدى(1, 6)
  $اكتب <<ك>> * <<ك>>, " "
نهاية
$اعرض
$اعرض صح و خطأ, صح او خطأ, ليس صح, 1 < 2 و 2 < 3
$اعرض $نوع(<<س>>), $نوع("ا"), $نوع(<<ق>>), $نوع(عدم), $نوع(صح)
$اعرض $ارقام_عربية(123.5), "ab" * 3, <<باي>> > 3
$اعرض $فرز([3, 1, 2]), $عكس("مرحبا"), $قص("مرحبا", 1, 3), $يحتوي([1,2], 2)
