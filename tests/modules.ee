متغير <<م>> = "/tmp/ee_modules_test.txt"
$اكتب_ملف(<<م>>, "أ" + "\n")
$الحق_ملف(<<م>>, "ب")
$اعرض $اسطر_ملف(<<م>>), $يوجد_ملف(<<م>>)
$اعرض $احذف_ملف(<<م>>), $يوجد_ملف(<<م>>)
$اعرض $وسائط()
$اخرج(3)
$اعرض "لا تصل"
