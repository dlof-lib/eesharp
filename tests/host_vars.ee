// المتغيرات الجديدة: <<اصدار>> <<مضيف>> <<منصة>> وغياب الصدفة
$اعرض $نوع(<<منصة>>), $نوع(<<اصدار>>)
$اعرض <<مضيف>>, $صدفة_متاح()
$اعرض $على_منصة("لا_توجد"), $على_منصة(<<منصة>>)
$اعرض $منصة() = <<منصة>>
مفهوم $اربط_زر
  $صدفة_اربط("#زر", "click", $اربط_زر)
نهاية
$اعرض "قبل"
$صدفة_نص("#عنوان", "مرحبا")
$اعرض "بعد"
