// المقارنة بالكلمات
متغير <<س>> = 5
$اعرض <<س>> اكبر من 3, <<س>> اصغر من 3, <<س>> يساوي 5, <<س>> لا يساوي 5
$اعرض <<س>> اكبر من او يساوي 5, <<س>> اصغر من او يساوي 4
$اعرض ليس <<س>> يساوي 3, ليس صح
لو <<س>> اكبر من 2 و <<س>> اصغر من 10
  $اعرض "بين ٢ و ١٠"
والا
  $اعرض "خارج النطاق"
نهاية
$اعرض $اكبر(1, 9, 4), "أ" يساوي "أ", "أ" لا يساوي "ب"
كرر <<س>> اصغر من 8
  <<س>> += 1
نهاية
$اعرض <<س>>
