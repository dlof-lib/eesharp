// مفاهيم النصوص الجديدة
$اعرض $استبدل("أهلاً يا عالم يا جميل", "يا", "و")
$اعرض $قسم("أ,ب,ج", ",")
$اعرض $قسم("نص", "")
$اعرض $دمج(["س", "ص", "ع"], "-"), $دمج([1, 2, 3])
$اعرض "[" + $قص_فراغ("  مرحبا  ") + "]"
$اعرض $حروف_كبيرة("hello"), $حروف_صغيرة("WORLD")
$اعرض $يبدأ_ب("مرحباً بك", "مرح"), $ينتهي_ب("مرحباً بك", "بك"), $يبدأ_ب("أ", "ب")
$اعرض $موضع("السلام عليكم", "عليكم"), $موضع("abc", "z")
$اعرض $نوع($وقت())
$اعرض $استبدل("aaa", "a", "bb")
$اعرض $استبدل("x", "", "y")
