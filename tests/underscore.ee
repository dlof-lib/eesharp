// _ تفصل كلمات اسم المتغير الواحد
متغير <<اسم_المستخدم>> = "سارة"
متغير <<عدد_المحاولات_الأقصى>> = 3
متغير <<x_1>> = 7
<<عدد_المحاولات_الأقصى>> += 1
$اعرض <<اسم_المستخدم>>, <<عدد_المحاولات_الأقصى>>, <<x_1>>
مفهوم $مجموع_الأعداد(<<قائمة_الأعداد>>)
  متغير <<ناتج_الجمع>> = 0
  لكل <<العدد_الحالي>> في <<قائمة_الأعداد>>
    <<ناتج_الجمع>> += <<العدد_الحالي>>
  نهاية لكل
  ارجع <<ناتج_الجمع>>
نهاية مفهوم
$اعرض $مجموع_الأعداد([1, 2, 3])
