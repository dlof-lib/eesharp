متغير <<م>> = $حلل_xml('<?xml version="1.0"?><مكتبة نوع="عام"><!-- ت --><كتاب رقم="1"><عنوان>الأيام &amp; الليالي</عنوان><سعر>12</سعر></كتاب><كتاب رقم="2"><عنوان><![CDATA[<مغامرة>]]></عنوان><سعر>30</سعر></كتاب><فارغ/></مكتبة>')
$اعرض $وسم(<<م>>), $سمة(<<م>>, "نوع"), $طول($ابناء(<<م>>))
لكل <<ك>> في $ابحث_xml(<<م>>, "كتاب")
  $اعرض $سمة(<<ك>>, "رقم"), $نص_عقدة($ابحث_xml(<<ك>>, "عنوان")[0]), $رقم($نص_عقدة($ابحث_xml(<<ك>>, "سعر")[0])) × 2
نهاية لكل
$اعرض $طول($ابحث_xml(<<م>>, "كتاب/سعر"))
$اعرض $اكتب_xml(<<م>>)
$اعرض $اكتب_xml($عقدة("أ", [["س", "<1>"]], [$عقدة("ب", [], [], "x&y")]), صح)
