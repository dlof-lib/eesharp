متغير <<أ>> = 123456789012345678901234567890
$اعرض <<أ>> * <<أ>>
$اعرض <<أ>> / 1000000007, <<أ>> % 1000000007
$اعرض -<<أ>> / 11, -<<أ>> % 11
$اعرض $نوع(<<أ>>), $نوع(<<أ>> - <<أ>>), <<أ>> > 5, 5 < <<أ>>, <<أ>> = 123456789012345678901234567890
$اعرض $اس_كبير(2, 100), $اس_بالباقي(4, 13, 497), $اولي_كبير($اس_كبير(2, 89) - 1)
$اعرض "ع: " + <<أ>>, $رقم(<<أ>>) > 100000000000000000000000000000, $كبير("٩٩٩٩٩٩٩٩٩٩٩٩٩٩٩٩٩٩") + 1
$اعرض <<أ>> / 0
