مفهوم $بدل(<<أ>>, <<ب>>)
  متغير <<ت>> = *<<أ>>
  *<<أ>> = *<<ب>>
  *<<ب>> = <<ت>>
نهاية مفهوم
متغير <<س>> = 1؛ متغير <<ص>> = 2
$بدل(&<<س>>, &<<ص>>)
$اعرض <<س>>, <<ص>>
متغير <<م>> = $احجز(5)
لكل <<ع>> في $مدى(5)؛ *(<<م>> + <<ع>>) = <<ع>> × 10؛ نهاية لكل
$اعرض *(<<م>> + 3), (<<م>> + 4) - <<م>>
متغير <<ق>> = [10, 20, 30]
متغير <<ع>> = &<<ق>>[1]
*<<ع>> += 5
$اعرض <<ق>>, *<<ع>>, *(<<ع>> + 1)
$حرر(<<م>>)
$حرر(<<م>>)
