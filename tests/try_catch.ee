برنامج اخطاء

مفهوم $قسم(<<أ>>, <<ب>>)
  لو <<ب>> = 0
    $ارم("القسمة على صفر")
  نهاية لو
  ارجع <<أ>> / <<ب>>
نهاية مفهوم

حاول
  $اعرض $قسم(10, 2)
  $اعرض $قسم(1, 0)
  $اعرض "لن تُطبع"
امسك <<خ>>
  $اعرض "التقطت:", <<خ>>
اخيرا
  $اعرض "تنظيف"
نهاية حاول

// أخطاء النظام قابلة للالتقاط
حاول
  متغير <<ق>> = [1, 2]
  $اعرض <<ق>>[9]
امسك <<خ>>
  $اعرض "نظام:", <<خ>>, "سطر", $سطر_الخطأ()
نهاية حاول

// قيمة مرمية من أي نوع + ارجع داخل حاول مع اخيرا
مفهوم $جرب()
  حاول
    $ارم(["مخصص", 42])
  امسك <<خ>>
    ارجع <<خ>>[1]
  اخيرا
    $اعرض "اخيرا داخل مفهوم"
  نهاية حاول
نهاية مفهوم
$اعرض $جرب()

// متداخل وإعادة الرمي
حاول
  حاول
    $ارم("داخلي")
  امسك <<ه>>
    $ارم("معاد: " + <<ه>>)
  نهاية حاول
امسك <<و>>
  $اعرض <<و>>
نهاية حاول

// توقف داخل حاول في حلقة
لكل <<ع>> في [1, 2, 3]
  حاول
    لو <<ع>> = 2
      توقف
    نهاية لو
    $اعرض "ع =", <<ع>>
  اخيرا
    $اعرض "ف", <<ع>>
  نهاية حاول
نهاية لكل

// بلا امسك: الخطأ يستمر بعد اخيرا
حاول
  $ارم("نهائي")
اخيرا
  $اعرض "قبل الانهيار"
نهاية حاول
$اعرض "لا تصل"
نهاية برنامج
