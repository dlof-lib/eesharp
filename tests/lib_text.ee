$اعرض $حروف_كبيرة("abc مرحبا"), $حروف_صغيرة("ABC Xyz"), "[" + $اقتطع("  س ص  ") + "]"
$اعرض $يبدا_نص("مرحبا بك", "مرحبا"), $ينتهي_نص("file.ee", ".ee"), $ينتهي_نص("a", "abc")
$اعرض $استبدل("اب اب اب", "اب", "ج"), $فصل("أ,ب,ج", ","), $فصل("سلام", ""), $اجمع_نص(["أ", "ب", 3], "-")
$اعرض $كرر_نص("ab", 3), $موضع_نص("مرحبا بالعالم", "بالعالم"), $موضع_نص("abc", "z")
$اعرض $حرف_كود("ا"), $كود_حرف(1575), $كود_حرف(65)
$اعرض "[" + $املأ_يسار("7", 3, "0") + "]", "[" + $املأ_يمين("ab", 5, ".") + "]", "[" + $املأ_يسار("طويل", 2) + "]"
$اعرض $عدد_كلمات("  واحد  اثنان ثلاثة "), $عدد_مرات("ababab", "ab"), $ازل_تشكيل("مَرْحَباً")
$اعرض $رابط_نظيف("  مرحبا بالعالم! Hello, World 2026 "), $هل_متناظر("A man, a plan, a canal: Panama"), $هل_متناظر("مرحبا")
$اعرض $ثنائي(10), $ثنائي(-5), $من_ثنائي("1010"), $ست_عشري(255), $تجزئة("EE#"), $تجزئة("")
$اعرض $رمز_url("مرحبا a/b?c=1&d"), $هرب_html("<a href=\"x\">&</a>")
$اعرض $تنسيق_رقم(1234567.891), $تنسيق_رقم(-1000), $تنسيق_رقم(999), $تنسيق_رقم(1234567, "٬")
$اعرض $ابتر("مرحبا بالعالم الجميل", 11), $ابتر("قصير", 10), $ابتر("abcdef", 3, "..")
$اعرض $رقم_بالحروف(1234567), $رقم_بالحروف(200000)
$اعرض $هل_نص("أ"), $هل_رقم(5), $هل_رقم($كبير(5)), $هل_قائمة([]), $هل_عدم(عدم), $هل_نص(5)
$اعرض $لون_rgb(255, 128, 0), $لون_hsl(0, 100, 50), $لون_hsl(120, 100, 25), $لون_hsl(210, 50, 50)
